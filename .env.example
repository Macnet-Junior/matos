# Auth.js / NextAuth — required for local and production
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# App URL (optional; used by Auth.js callbacks)
AUTH_URL=http://localhost:3000

# SQLite (Prisma) — relative to packages/db/prisma when running db scripts
DATABASE_URL="file:./dev.db"

# Owner email — always resolves as Owner (RBAC)
OWNER_EMAIL=macnet@matos.local

# Dev credentials provider accepts any email + password "dev"
# Seeded roles: macnet@ (Owner), operator@, author@, viewer@matos.local
# Assign more roles via UserRole table — see README.

# Auth.js / NextAuth — required for local and production
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# App URL (optional; used by Auth.js callbacks)
AUTH_URL=http://localhost:3000

# SQLite (Prisma) — relative to packages/db/prisma when running db scripts
DATABASE_URL="file:./dev.db"

# Owner email — always resolves as Owner (RBAC)
OWNER_EMAIL=macnet@matos.local

# Dev credentials provider accepts any email + password "dev"
# Seeded roles: macnet@ (Owner), operator@, author@, viewer@matos.local
# Assign more roles via UserRole table — see README.

# ── Phase 4b integrations (optional — without keys, paths stay simulated) ──

# Encrypt IntegrationCredential rows (falls back to AUTH_SECRET-derived key in dev)
# Generate: openssl rand -base64 32
CREDENTIALS_SECRET=

# Late.dev / Zernio social API
# Docs: https://docs.zernio.com/ (formerly getlate.dev)
LATE_API_KEY=
# Default: https://zernio.com/api/v1
LATE_API_BASE=

# Etsy Open API v3 (OAuth2 + PKCE)
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=http://localhost:3000/api/integrations/etsy/oauth/callback

# WhatsApp Cloud API — HARD BOUNDARY: only WHATSAPP_GROUP_OR_TO may be messaged
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Must be the Career path / content creation monetization group or user id
WHATSAPP_GROUP_OR_TO=

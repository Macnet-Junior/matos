# Auth.js / NextAuth — required for local and production
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# App URL (optional for Phase 0; used by Auth.js callbacks)
AUTH_URL=http://localhost:3000

# Dev credentials provider accepts any email + password "dev"
# or the one-click "Continue as Macnet Junior" button.

# Hosted MatOS environment names only. Do not put real secrets in git.
# Inject values from the host secret manager.

NODE_ENV=production
AUTH_SECRET=
AUTH_URL=https://matos.example.com
DATABASE_URL=file:/var/lib/matos/prod.db
OWNER_EMAIL=macnet@matos.local
MATOS_AUTH_PASSWORD=
CREDENTIALS_SECRET=

# Optional providers. Empty values keep those channels simulated.
LATE_API_KEY=
LATE_API_BASE=
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=https://matos.example.com/api/integrations/etsy/oauth/callback
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GROUP_OR_TO=
NEWSLETTER_DELIVERY_URL=
BLOG_DELIVERY_URL=
OPENAI_API_KEY=

# Live Stripe is intentionally unsupported. Leave these unset.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

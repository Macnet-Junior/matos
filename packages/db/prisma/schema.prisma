generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String       @id @default(cuid())
  name      String
  summary   String
  posX      Float        @default(280)
  posY      Float        @default(220)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  departments Department[]
}

model Department {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  summary   String
  sortOrder Int      @default(0)
  posX      Float    @default(0)
  posY      Float    @default(0)
  expanded  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skills    Skill[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model Skill {
  id           String   @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  slug         String
  title        String
  description  String
  /// authored | planned | missing
  status       String   @default("planned")
  owner        String   @default("Macnet Junior")
  /// Cold | Warm | Hot
  reviewGate   String   @default("Warm")
  purpose      String   @default("")
  instructions String   @default("")
  /// JSON array of step strings
  stepsJson    String   @default("[]")
  /// JSON array of evidence strings
  evidenceJson String   @default("[]")
  posX         Float?
  posY         Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  knowledge    SkillKnowledge[]

  @@unique([departmentId, slug])
  @@index([departmentId])
  @@index([status])
}

model SkillKnowledge {
  id        String   @id @default(cuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  path      String
  title     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([skillId, path])
  @@index([skillId])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  summary    String
  actorEmail String?
  /// JSON payload
  payloadJson String  @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id          String       @id @default(cuid())
  name        String
  summary     String
  posX        Float        @default(280)
  posY        Float        @default(220)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
}

model Department {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  summary   String
  sortOrder Int      @default(0)
  posX      Float    @default(0)
  posY      Float    @default(0)
  expanded  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skills    Skill[]

  @@unique([companyId, slug])
  @@index([companyId])
}

model Skill {
  id           String   @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  slug         String
  title        String
  description  String
  /// authored | planned | missing
  status       String   @default("planned")
  owner        String   @default("Macnet Junior")
  /// Cold | Warm | Hot — required review intensity for the skill
  reviewGate   String   @default("Warm")
  purpose      String   @default("")
  instructions String   @default("")
  /// JSON array of step strings
  stepsJson    String   @default("[]")
  /// JSON array of evidence links: {url,label}[] (legacy string[] accepted on read)
  evidenceJson String   @default("[]")
  posX         Float?
  posY         Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  knowledge    SkillKnowledge[]
  workflowSteps WorkflowStep[]

  @@unique([departmentId, slug])
  @@index([departmentId])
  @@index([status])
}

model SkillKnowledge {
  id        String   @id @default(cuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  path      String
  title     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([skillId, path])
  @@index([skillId])
}

model ActivityEvent {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  summary     String
  actorEmail  String?
  /// JSON payload
  payloadJson String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

/// Ordered skill chain. Content gate: draft → warm → approved → scheduled → published
model Workflow {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  /// draft | warm | approved | scheduled | published
  gateState   String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  steps       WorkflowStep[]
  runs        WorkflowRun[]
}

model WorkflowStep {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict)
  sortOrder  Int
  label      String?
  createdAt  DateTime @default(now())

  @@unique([workflowId, sortOrder])
  @@index([workflowId])
  @@index([skillId])
}

model WorkflowRun {
  id           String   @id @default(cuid())
  workflowId   String
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  /// running | completed | failed | blocked
  status       String   @default("running")
  /// draft | warm | approved | scheduled | published
  gateState    String   @default("draft")
  dryRun       Boolean  @default(true)
  summary      String   @default("")
  /// JSON aggregate artifacts / trace meta
  artifactJson String   @default("{}")
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  actorEmail   String?
  steps        RunStep[]

  @@index([workflowId])
  @@index([startedAt])
  @@index([gateState])
}

model RunStep {
  id             String   @id @default(cuid())
  runId          String
  run            WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  workflowStepId String?
  skillId        String
  skillSlug      String
  skillTitle     String
  sortOrder      Int
  /// pending | running | completed | skipped | blocked
  status         String   @default("pending")
  /// draft | warm | approved | scheduled | published
  gateState      String   @default("draft")
  logJson        String   @default("[]")
  artifactJson   String   @default("{}")
  startedAt      DateTime?
  finishedAt     DateTime?

  @@index([runId])
  @@index([sortOrder])
}

/// Email → role for RBAC (Phase 4). OWNER_EMAIL always resolves as Owner.
model UserRole {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Owner | Operator | Author | Viewer
  role      String   @default("Viewer")
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

/// External channel connection (Late / Etsy / WhatsApp). One row per provider.
model IntegrationAccount {
  id          String   @id @default(cuid())
  /// late | etsy | whatsapp
  provider    String   @unique
  label       String   @default("")
  /// connected | disconnected | error
  status      String   @default("disconnected")
  externalId  String?
  /// JSON metadata (non-secret): shop name, profile count, allowed destination label, etc.
  metaJson    String   @default("{}")
  lastError   String?
  connectedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  credentials IntegrationCredential[]

  @@index([status])
}

/// Encrypted credential blob — never log plaintext.
model IntegrationCredential {
  id         String   @id @default(cuid())
  accountId  String
  account    IntegrationAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// api_key | access_token | refresh_token | shared_secret | code_verifier | state
  kind       String
  ciphertext String
  iv         String
  authTag    String
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([accountId, kind])
  @@index([accountId])
}

/// Phase 5 — who is online / recently active
model UserPresence {
  id          String   @id @default(cuid())
  email       String   @unique
  role        String   @default("Viewer")
  lastSeenAt  DateTime @default(now())
  currentPath String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lastSeenAt])
}

/// Metered resource pulls (AI credits, Late, Etsy, WhatsApp, API hits)
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  units     Float    @default(1)
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([kind])
  @@index([createdAt])
}

/// Credits grant / consume / adjust ledger (stub pricing — no Stripe)
model CreditLedger {
  id           String   @id @default(cuid())
  userId       String
  /// grant | consume | adjust
  entryType    String
  units        Float
  balanceAfter Float
  note         String   @default("")
  actorEmail   String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Approved auto-reply rules — cannot enable without Owner/Operator + approved gate
model AutoResponseRule {
  id             String   @id @default(cuid())
  name           String
  triggerKeyword String
  /// whatsapp | late | support | email
  channel        String   @default("support")
  template       String
  enabled        Boolean  @default(false)
  /// pending | approved | rejected
  reviewGate     String   @default("pending")
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  attempts       AutoResponseAttempt[]

  @@index([enabled])
  @@index([channel])
}

model AutoResponseAttempt {
  id         String   @id @default(cuid())
  ruleId     String
  rule       AutoResponseRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  /// attempted | blocked | sent_sim
  status     String
  detail     String   @default("")
  actorEmail String?
  createdAt  DateTime @default(now())

  @@index([ruleId])
  @@index([createdAt])
}

model SupportTicket {
  id             String   @id @default(cuid())
  subject        String
  body           String
  /// open | pending | solved
  status         String   @default("open")
  /// low | normal | high
  priority       String   @default("normal")
  requesterEmail String
  assigneeEmail  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  messages       SupportMessage[]

  @@index([status])
  @@index([requesterEmail])
  @@index([createdAt])
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorEmail String
  body        String
  /// comment | system
  kind        String        @default("comment")
  createdAt   DateTime      @default(now())

  @@index([ticketId])
}

model ChatThread {
  id        String        @id @default(cuid())
  userEmail String
  title     String        @default("Support chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userEmail])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// user | assistant | system
  role      String
  body      String
  metaJson  String     @default("{}")
  createdAt DateTime   @default(now())

  @@index([threadId])
}

/// Phase 5.5 — Relay Desk content job (newsroom pipeline)
model DeskJob {
  id           String   @id @default(cuid())
  title        String
  topic        String
  audience     String   @default("")
  offerCta     String   @default("")
  /// JSON string array of channel names
  channelsJson String   @default("[]")
  dueAt        DateTime?
  /// scout | ghost | editor | press | clock | echo | filed
  stage        String   @default("scout")
  /// draft | generating | awaiting_approval | changes_requested | approved | filed
  status       String   @default("draft")
  createdBy    String
  filedAt      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  artifacts    DeskStageArtifact[]
  calendarItems DeskCalendarItem[]
  inboxItems   DeskInboxItem[]
  publications DeskPublication[]

  @@index([stage])
  @@index([status])
  @@index([createdAt])
  @@index([filedAt])
}

model DeskStageArtifact {
  id          String   @id @default(cuid())
  jobId       String
  job         DeskJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// scout | ghost | editor | press | clock | echo
  stage       String
  title       String
  body        String   @default("")
  /// pending | ready | approved | changes_requested
  reviewState String   @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String   @default("")
  /// Structured channel packages for Press, or "{}" for other stages.
  packageJson String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revisions   DeskArtifactRevision[]

  @@unique([jobId, stage])
  @@index([jobId])
  @@index([stage])
}

/// Prior body captured before an edit or approval.
model DeskArtifactRevision {
  id          String            @id @default(cuid())
  artifactId  String
  artifact    DeskStageArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  title       String
  body        String            @default("")
  packageJson String            @default("{}")
  reviewState String
  editedBy    String
  createdAt   DateTime          @default(now())

  @@index([artifactId])
  @@index([createdAt])
}

model DeskCalendarItem {
  id          String   @id @default(cuid())
  jobId       String
  job         DeskJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  channel     String
  title       String
  body        String   @default("")
  scheduledAt DateTime
  /// planned | invalid | simulated | published | failed
  status      String   @default("planned")
  /// Structured channel package rendered into body.
  packageJson String   @default("{}")
  /// True when the latest delivery was a simulation, never a live post.
  simulated   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobId])
  @@index([scheduledAt])
}

model DeskInboxItem {
  id         String   @id @default(cuid())
  jobId      String
  job        DeskJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  channel    String
  subject    String
  body       String   @default("")
  /// drafted | approved | copied — sending stays gated (no live network send)
  status     String   @default("drafted")
  approvedBy String?
  approvedAt DateTime?
  copiedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

/// Content delivery attempt for an approved Desk job.
model DeskPublication {
  id             String   @id @default(cuid())
  jobId          String
  job            DeskJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  channel        String
  provider       String
  idempotencyKey String   @unique
  externalId     String?
  /// planned | publishing | published | failed
  status         String   @default("planned")
  scheduledAt    DateTime?
  publishedAt    DateTime?
  attemptCount   Int      @default(0)
  lastAttemptAt  DateTime?
  error          String?
  /// Provider response and non-secret delivery metadata.
  metaJson       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  metrics        ContentMetric[]
  insights       ContentInsight[]

  @@unique([jobId, channel])
  @@index([status])
  @@index([channel])
  @@index([scheduledAt])
}

/// Measured outcome for a published content item.
model ContentMetric {
  id            String         @id @default(cuid())
  publicationId String
  publication   DeskPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  kind          String
  value         Float
  capturedAt    DateTime       @default(now())
  /// Provider-specific period, post, or import metadata.
  metaJson      String         @default("{}")
  createdAt     DateTime       @default(now())

  @@index([publicationId])
  @@index([kind])
  @@index([capturedAt])
}

/// Reviewed performance note that may link back to a skill or knowledge file.
model ContentInsight {
  id            String           @id @default(cuid())
  publicationId String?
  publication   DeskPublication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  summary       String
  skillSlug     String?
  knowledgePath String?
  /// draft | reviewed
  status        String           @default("draft")
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())

  @@index([publicationId])
  @@index([status])
  @@index([skillSlug])
}

/// Scaffold for privacy export and deletion requests. Completion stays reviewed.
model PrivacyRequest {
  id           String    @id @default(cuid())
  /// export | deletion
  kind         String
  subjectEmail String
  /// pending | completed
  status       String    @default("pending")
  requestedBy  String
  note         String    @default("")
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([subjectEmail])
  @@index([status])
  @@index([kind])
}
